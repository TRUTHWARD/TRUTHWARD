# Generated into .env by: python scripts/community.py configure
# Local, single-instance Community installation. Never commit the generated .env.
DEPLOYMENT_PROFILE=oss
APP_ENV=local
API_PREFIX=/api/v1
POSTGRES_USER=community
POSTGRES_DB=truthward_community
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
COMMUNITY_DB_PORT=__POSTGRES_PORT__
DATABASE_URL=postgresql+psycopg://community:__POSTGRES_PASSWORD__@127.0.0.1:__POSTGRES_PORT__/truthward_community
REDIS_PASSWORD=__REDIS_PASSWORD__
COMMUNITY_REDIS_PORT=__REDIS_PORT__
REDIS_URL=redis://:__REDIS_PASSWORD__@127.0.0.1:__REDIS_PORT__/0
QUEUE_MODE=inline
AUTO_CREATE_TABLES=false
ARTIFACT_STORAGE_DIR=.tmp/artifacts
RUNNER_ARTIFACT_DIR=.tmp/runner-artifacts
REPLAY_REPOSITORY_STORAGE_ADAPTER=local
REPLAY_REPOSITORY_STORAGE_DIR=.tmp/replay-repository
COMMUNITY_SKILL_MANIFEST_DIR=community-skills
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
