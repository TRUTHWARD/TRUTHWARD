      "category": "business_logic",
      "severity": "high",
      "title": "Cart total ignores quantity",
      "oracle": "10.00 × 3 must equal 30.00; the endpoint returns 10.00.",
      "location": {
        "path": "examples/public_quality_benchmark/app.py",
        "line": 21,
        "symbol": "calculate_cart_total"
      },
      "reproduction": {
        "method": "GET",
        "path": "/api/cart/total?price=10&quantity=3",
        "expected": {"total": 30.0},
        "observed": {"total": 10.0}
      },
      "evidenceRequirements": ["rawRef", "location", "reproduction", "traceRef"]
    },
