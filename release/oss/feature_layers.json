{
  "schemaVersion": "truthward.oss-feature-layers.v2",
  "productIntent": "self_hosted_community_platform",
  "decisionStatus": "community_core_v1_implemented",
  "runtimeBaseline": {
    "manifestPath": "release/oss/manifest.json",
    "currentProfile": "community_core_v1",
    "targetProfile": "usable_community_core",
    "plannedCapabilitiesAreNotRuntimeGrants": true
  },
  "visibilityPolicy": {
    "zeroProject": "show_onboarding_instead_of_project_selector",
    "oneProject": "show_static_project_scope",
    "multipleProjects": "show_project_selector",
    "conditionalModules": "hide_until_backend_readiness_and_required_data_are_present",
    "unavailableMutations": "do_not_render",
    "deepLinks": "fail_closed_to_a_relevant_onboarding_or_unavailable_state"
  },
  "layers": [
    {
      "id": "oss_core",
      "licenseTarget": "Apache-2.0",
      "description": "A complete self-hosted community workflow. Security, scope enforcement, redaction, and fail-closed behavior are part of the core and are not Enterprise-only features."
    },
    {
      "id": "oss_conditional",
      "licenseTarget": "Apache-2.0",
      "description": "Community features whose navigation is readiness-gated by a configured dependency or persisted upstream data."
    },
    {
      "id": "enterprise",
      "licenseTarget": "LicenseRef-TRUTHWARD-Proprietary",
      "description": "Organization-scale, cross-tenant, high-risk governance and commercial administration extensions."
    }
  ],
