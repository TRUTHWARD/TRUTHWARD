{
  "name": "agentic-qa-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:oss": "tsc -p tsconfig.oss.json && vite build --mode oss",
    "lint": "eslint . --max-warnings 13",
    "preview": "vite preview",
    "test": "vitest run",
    "test:oss": "vitest run --mode oss",
    "test:components": "vitest run tests/RouteStateMatrix.test.tsx tests/RouteStateBehavior.test.tsx",
    "test:route-api": "vitest run tests/RouteStateMatrix.test.tsx tests/RouteStateBehavior.test.tsx tests/ApiContractMatrix.test.ts",
    "test:i18n": "vitest run tests/LocaleQuality.test.ts",
    "test:coverage": "vitest run --coverage",
    "test:coverage:release": "vitest run --coverage"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "16.3.0",
    "jsdom": "26.1.0",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "8.65.0",
    "vite": "^6.4.3",
    "vitest": "3.2.7"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "nanoid": "3.3.18",
    "test-exclude": "8.0.0"
  }
}
