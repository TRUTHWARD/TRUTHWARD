{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase8.gate-policy-resolution-result.v1",
  "title": "Gate Policy Resolution Result",
  "description": "Read-only deterministic selection result with a complete frozen policy snapshot.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "source",
    "resolvedPolicyId",
    "resolvedPolicyRef",
    "resolvedPolicyKey",
    "resolvedPolicyVersionId",
    "resolvedPolicyVersionRef",
    "resolvedPolicyVersionNumber",
    "resolvedPolicyVersionHash",
    "resolvedBindingId",
    "resolvedBindingRef",
    "resolvedScope",
    "fallbackReason",
    "resolutionTrace",
    "snapshot",
    "snapshotHash",
    "writesGateDecision"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "phase8.gate-policy-resolution-result.v1"
    },
    "source": {"type": "string", "enum": ["binding", "builtin_default"]},
    "resolvedPolicyId": {"type": "string", "minLength": 1, "maxLength": 64},
    "resolvedPolicyRef": {
      "type": "string",
      "pattern": "^(?:gate-policy|builtin-gate-policy)://\\S+$",
      "maxLength": 500
    },
    "resolvedPolicyKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{2,127}$"
    },
    "resolvedPolicyVersionId": {"type": "string", "minLength": 1, "maxLength": 64},
    "resolvedPolicyVersionRef": {
      "type": "string",
      "pattern": "^(?:gate-policy-version|builtin-gate-policy-version)://\\S+$",
      "maxLength": 500
    },
    "resolvedPolicyVersionNumber": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "resolvedPolicyVersionHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "resolvedBindingId": {"type": ["string", "null"], "maxLength": 64},
    "resolvedBindingRef": {
      "type": ["string", "null"],
      "maxLength": 500
    },
    "resolvedScope": {"$ref": "#/$defs/resolvedScope"},
    "fallbackReason": {"$ref": "#/$defs/fallbackReason"},
    "resolutionTrace": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {"$ref": "#/$defs/traceEntry"}
    },
    "snapshot": {"$ref": "#/$defs/snapshot"},
    "snapshotHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "writesGateDecision": {"type": "boolean", "const": false}
  },
  "$defs": {
    "scopeType": {
      "type": "string",
      "enum": ["environment", "project", "workspace", "stage", "domain", "global", "builtin_default"]
    },
    "fallbackReason": {
      "type": "string",
      "enum": [
        "explicit_selection",
        "environment_missing",
        "project_missing",
        "workspace_missing",
        "stage_missing",
        "domain_missing",
        "global_missing",
        "disabled",
        "not_effective",
        "version_unavailable",
        "hash_mismatch",
        "conflict",
        "context_incomplete",
        "schema_invalid",
        "scope_mismatch",
        "cross_tenant",
        "db_failure",
        "builtin_default"
      ]
    },
    "resolvedScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "scopeId"],
      "properties": {
        "type": {"$ref": "#/$defs/scopeType"},
        "scopeId": {"type": ["string", "null"], "maxLength": 255}
      }
    },
    "traceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "requestedScopeId", "outcome", "reason", "candidateCount", "checkedBindingRefs"],
      "properties": {
        "scope": {"$ref": "#/$defs/scopeType"},
        "requestedScopeId": {"type": ["string", "null"], "maxLength": 255},
        "outcome": {"type": "string", "enum": ["selected", "skipped", "fallback", "error"]},
        "reason": {"$ref": "#/$defs/fallbackReason"},
        "candidateCount": {"type": "integer", "minimum": 0, "maximum": 100000},
        "checkedBindingRefs": {
          "type": "array",
          "maxItems": 256,
          "items": {"type": "string", "pattern": "^gate-policy-binding://\\S+$"}
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bindingId",
        "bindingRef",
        "status",
        "scopeType",
        "scopeId",
        "effectiveFrom",
        "effectiveUntil",
        "policyId",
        "policyVersionId",
        "policyVersionHash"
      ],
      "properties": {
        "bindingId": {"type": "string", "minLength": 1, "maxLength": 64},
        "bindingRef": {"type": "string", "pattern": "^gate-policy-binding://\\S+$"},
        "status": {"type": "string", "const": "active"},
        "scopeType": {
          "type": "string",
          "enum": ["environment", "project", "workspace", "stage", "domain", "global"]
        },
        "scopeId": {"type": ["string", "null"], "maxLength": 255},
        "effectiveFrom": {"type": "string", "format": "date-time"},
        "effectiveUntil": {"type": ["string", "null"], "format": "date-time"},
        "policyId": {"type": "string", "minLength": 1, "maxLength": 64},
        "policyVersionId": {"type": "string", "minLength": 1, "maxLength": 64},
        "policyVersionHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "request",
        "source",
        "policyId",
        "policyRef",
        "policyKey",
        "policyVersionId",
        "policyVersionRef",
        "policyVersionNumber",
        "policySchemaVersion",
        "policyVersionHash",
        "binding",
        "resolvedScope",
        "fallbackReason",
        "resolutionTrace",
        "policy"
      ],
      "properties": {
        "schemaVersion": {"type": "string", "const": "phase8.gate-policy-resolution-snapshot.v1"},
        "request": {"type": "object"},
        "source": {"type": "string", "enum": ["binding", "builtin_default"]},
        "policyId": {"type": "string", "minLength": 1, "maxLength": 64},
        "policyRef": {"type": "string", "maxLength": 500},
        "policyKey": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,127}$"},
        "policyVersionId": {"type": "string", "minLength": 1, "maxLength": 64},
        "policyVersionRef": {"type": "string", "maxLength": 500},
        "policyVersionNumber": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "policySchemaVersion": {"type": "string", "const": "gate-policy.v1"},
        "policyVersionHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "binding": {"anyOf": [{"$ref": "#/$defs/binding"}, {"type": "null"}]},
        "resolvedScope": {"$ref": "#/$defs/resolvedScope"},
        "fallbackReason": {"$ref": "#/$defs/fallbackReason"},
        "resolutionTrace": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {"$ref": "#/$defs/traceEntry"}
        },
        "policy": {"type": "object"}
      }
    }
  }
}
