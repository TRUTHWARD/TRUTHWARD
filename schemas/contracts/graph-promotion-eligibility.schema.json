{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase8.graph-promotion-eligibility.v1",
  "title": "Fail-Closed Graph Promotion Eligibility Assessment",
  "type": "object",
  "additionalProperties": false,
  "required": ["assessmentId", "proposalId", "graphId", "candidateVersionId", "baseVersionId", "learningMode", "riskLevel", "eligible", "automaticPromotionAllowed", "humanReviewRequired", "checks", "reasonCodes", "policyVersionId", "policyVersionHash", "bindingId", "eligibilityHash", "evaluatedAt"],
  "properties": {
    "schemaVersion": {"type": "string", "const": "phase8.graph-promotion-eligibility.v1"},
    "assessmentId": {"type": "string"},
    "proposalId": {"type": "string"},
    "graphId": {"type": "string"},
    "candidateVersionId": {"type": "string"},
    "baseVersionId": {"type": "string"},
    "learningMode": {"type": "string", "enum": ["learn_only", "human_supervised", "controlled_autonomy"]},
    "riskLevel": {"type": "string", "enum": ["low", "medium", "high"]},
    "eligible": {"type": "boolean"},
    "automaticPromotionAllowed": {"type": "boolean"},
    "humanReviewRequired": {"type": "boolean"},
    "checks": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "reasonCodes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "policyVersionId": {},
    "policyVersionHash": {"type": "string"},
    "bindingId": {},
    "eligibilityHash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "evaluatedAt": {"type": "string"}
  }
}
