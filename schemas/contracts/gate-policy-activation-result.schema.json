{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase8.gate-policy-activation-result.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["activationRequestId", "status", "projectId", "policyId", "policyVersionId", "policyVersionHash", "simulationRunId", "approvalId", "traceRef", "authoritative"],
  "properties": {
    "schemaVersion": {"type": "string", "const": "phase8.gate-policy-activation-result.v1"},
    "activationRequestId": {"type": "string", "format": "uuid"},
    "status": {"type": "string", "enum": ["approval_pending", "applied"]},
    "projectId": {"type": "string", "format": "uuid"},
    "policyId": {"type": "string", "format": "uuid"},
    "policyVersionId": {"type": "string", "format": "uuid"},
    "policyVersionHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "simulationRunId": {"type": "string", "format": "uuid"},
    "approvalId": {"type": "string", "format": "uuid"},
    "bindingId": {"type": ["string", "null"], "format": "uuid"},
    "previousBindingId": {"type": ["string", "null"], "format": "uuid"},
    "traceRef": {"type": "string"},
    "authoritative": {"type": "boolean"},
    "effectiveFrom": {"type": ["string", "null"], "format": "date-time"}
  }
}
