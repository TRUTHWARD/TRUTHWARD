{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase8.code-change-set.v1",
  "title": "Code Change Set",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "changeSetId", "changeSetType", "projectId", "environmentId", "sourceSnapshotId", "sourceType", "sourceId", "sourceRevision", "sourceContentHash", "fingerprint", "normalizerVersion", "status", "itemCount", "issueCount", "sensitive", "sourceRefs", "artifactRefs", "replayRefs", "traceId", "issues", "deduplicated", "createdAt", "repositoryRef", "baseSha", "headSha", "files", "fullDiffStoredInDatabase", "impactAnalysisPerformed"],
  "properties": {
    "schemaVersion": {"const": "phase8.code-change-set.v1"},
    "changeSetId": {"type": "string"},
    "changeSetType": {"const": "code"},
    "projectId": {"type": "string"},
    "environmentId": {"type": ["string", "null"]},
    "sourceSnapshotId": {"type": "string"},
    "sourceType": {"type": "string"},
    "sourceId": {"type": "string"},
    "sourceRevision": {"type": "string"},
    "sourceContentHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "fingerprint": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "normalizerVersion": {"type": "string"},
    "status": {"enum": ["completed", "partial", "unknown"]},
    "itemCount": {"type": "integer", "minimum": 0},
    "issueCount": {"type": "integer", "minimum": 0},
    "sensitive": {"type": "boolean"},
    "sourceRefs": {"type": "array", "items": {"type": "object"}},
    "artifactRefs": {"type": "array", "items": {"type": "object"}},
    "replayRefs": {"type": "array", "items": {"type": "object"}},
    "traceId": {"type": "string"},
    "issues": {"type": "array", "items": {"$ref": "normalization-issue.schema.json"}},
    "deduplicated": {"type": "boolean"},
    "createdAt": {"type": "string"},
    "repositoryRef": {"type": "string"},
    "baseSha": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
    "headSha": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fileId", "path", "oldPath", "changeType", "language", "binary", "generated", "vendor", "submodule", "riskHints", "diffArtifactRefs", "hunks"],
        "properties": {
          "fileId": {"type": "string"},
          "path": {"type": "string"},
          "oldPath": {"type": ["string", "null"]},
          "changeType": {"enum": ["add", "update", "remove", "rename", "copy", "unknown"]},
          "language": {"type": ["string", "null"]},
          "binary": {"type": "boolean"},
          "generated": {"type": "boolean"},
          "vendor": {"type": "boolean"},
          "submodule": {"type": "boolean"},
          "riskHints": {"type": "array", "items": {"type": "string"}},
          "diffArtifactRefs": {"type": "array", "items": {"type": "object"}},
          "hunks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["hunkId", "header", "oldLineStart", "oldLineCount", "newLineStart", "newLineCount", "contentHash", "diffArtifactRefs", "sensitive", "redactionCount", "symbols"],
              "properties": {
                "hunkId": {"type": "string"},
                "header": {"type": "string"},
                "oldLineStart": {"type": ["integer", "null"]},
                "oldLineCount": {"type": ["integer", "null"]},
                "newLineStart": {"type": ["integer", "null"]},
                "newLineCount": {"type": ["integer", "null"]},
                "contentHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
                "diffArtifactRefs": {"type": "array", "items": {"type": "object"}},
                "sensitive": {"type": "boolean"},
                "redactionCount": {"type": "integer", "minimum": 0},
                "symbols": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["symbolId", "name", "kind", "changeType", "oldLineStart", "oldLineEnd", "newLineStart", "newLineEnd", "confidence", "evidence"],
                    "properties": {
                      "symbolId": {"type": "string"},
                      "name": {"type": "string"},
                      "kind": {"type": "string"},
                      "changeType": {"enum": ["add", "update", "remove", "unknown"]},
                      "oldLineStart": {"type": ["integer", "null"]},
                      "oldLineEnd": {"type": ["integer", "null"]},
                      "newLineStart": {"type": ["integer", "null"]},
                      "newLineEnd": {"type": ["integer", "null"]},
                      "confidence": {"type": "number", "minimum": 0, "maximum": 1},
                      "evidence": {"type": "array", "items": {"type": "object"}}
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "fullDiffStoredInDatabase": {"const": false},
    "impactAnalysisPerformed": {"const": false}
  }
}
