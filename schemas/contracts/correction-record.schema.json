{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase8.correction-record.v1",
  "title": "Correction Record Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "correctionId", "requirementVersionId", "executionId", "targetType", "targetId", "before", "after", "reason", "actorRef", "evidenceRefs", "affectedAssetRefs", "createdAt", "metadata"],
  "properties": {
    "schemaVersion": {"type": "string", "const": "phase8.correction-record.v1"},
    "correctionId": {"type": "string"},
    "requirementVersionId": {"type": "string"},
    "executionId": {"type": ["string", "null"]},
    "targetType": {"type": "string"},
    "targetId": {"type": "string"},
    "before": {"type": "object"},
    "after": {"type": "object"},
    "reason": {"type": "string", "minLength": 1},
    "actorRef": {"type": "object"},
    "evidenceRefs": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "affectedAssetRefs": {"type": "array", "items": {"type": "object"}},
    "createdAt": {"type": "string"},
    "metadata": {"type": "object"}
  }
}
