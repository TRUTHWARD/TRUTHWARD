            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Occurredat"
        },
        "contentHash": {
          "anyOf": [
            {
              "pattern": "^sha256:[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contenthash"
        },
        "sourceRefs": {
          "items": {
            "$ref": "#/$defs/StableProjectionRef"
