            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rawprojection"
        },
        "unavailableReason": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
