        "coverageRead": {
          "title": "Coverageread",
          "type": "boolean"
        },
        "stalenessRead": {
          "title": "Stalenessread",
          "type": "boolean"
        },
        "evidenceRead": {
          "title": "Evidenceread",
          "type": "boolean"
        },
        "rawRead": {
          "title": "Rawread",
          "type": "boolean"
        },
        "proposeCorrection": {
          "title": "Proposecorrection",
          "type": "boolean"
        },
        "readOnly": {
          "const": true,
          "title": "Readonly",
          "type": "boolean"
        },
        "backendAuthorization": {
