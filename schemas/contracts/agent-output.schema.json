{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase8.agent-output.v1",
  "title": "Agent Output Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["result", "confidence", "evidence", "limitations", "metadata"],
  "properties": {
    "result": {
      "type": "object"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": ["string", "object"]
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metadata": {
      "type": "object"
    }
  }
}
