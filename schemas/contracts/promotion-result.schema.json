    "promotionResultId": {"type": "string"},
    "candidateId": {"type": "string"},
    "status": {"type": "string"},
    "memoryType": {"type": "string"},
    "memoryRef": {"type": "object"},
    "approvalRefs": {"type": "array", "items": {"type": "object"}},
    "approvalState": {"type": "string"},
    "guardrailEventRefs": {"type": "array", "items": {"type": "object"}},
    "auditRefs": {"type": "array", "items": {"type": "object"}},
    "evidenceRefs": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "rawRefs": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "policySnapshot": {"type": "object"},
    "projectionState": {"type": "string"},
