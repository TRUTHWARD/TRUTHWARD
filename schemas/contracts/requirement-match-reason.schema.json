{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase8.requirement-match-reason.v1",
  "title": "Requirement Match Reason",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "layer", "explanationKey"],
  "properties": {
    "code": {"type": "string", "minLength": 1},
    "layer": {"enum": ["explicit", "mapping", "traceability", "rule_history", "ai"]},
    "explanationKey": {"type": "string", "minLength": 1},
    "evidenceRefs": {"type": "array"}
  }
}
