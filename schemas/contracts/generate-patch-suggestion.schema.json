{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase8.generate-patch-suggestion.v1",
  "title": "Generate Patch Suggestion Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "changeType", "targetRef", "patchSuggestion", "rationale", "riskLevel", "evidenceRefs", "metadata"],
  "properties": {
    "schemaVersion": {"type": "string", "const": "phase8.generate-patch-suggestion.v1"},
    "changeType": {"type": "string", "const": "generate_patch_suggestion"},
    "targetRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "id": {"type": "string", "minLength": 1}
      }
    },
    "patchSuggestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["patchRef", "summary", "diffRefs", "suggestedFiles"],
      "properties": {
        "patchRef": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "diffRefs": {"type": "array", "items": {"type": "object"}},
        "suggestedFiles": {"type": "array", "items": {"type": "string"}}
      }
    },
    "rationale": {"type": "string", "minLength": 1},
    "riskLevel": {"type": "string", "enum": ["low", "medium", "high"]},
    "evidenceRefs": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "metadata": {"type": "object"}
  }
}
