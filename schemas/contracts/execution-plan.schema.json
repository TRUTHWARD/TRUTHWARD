    "schemaVersion": {"type": "string", "const": "phase8.execution-plan.v1"},
    "executionPlanId": {"type": "string"},
    "requirementVersionId": {"type": "string"},
    "testPlanId": {"type": "string"},
    "status": {"type": "string"},
    "riskLevel": {"type": "string"},
    "approvalRequired": {"type": "boolean"},
    "tasks": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "assetRefs": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "retryStrategy": {"type": "object"},
    "replayRefs": {"type": "array", "items": {"type": "object"}},
    "requirementScope": {"type": "object"},
    "metadata": {"type": "object"}
