{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase8.gate-policy-simulation-run.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["simulationRunId", "projectId", "policyId", "policyVersionId", "policyVersionHash", "evaluatorVersion", "runType", "status", "datasetFingerprint", "totalCases", "completedCases", "unavailableCases", "failedCases", "retentionUntil", "createdAt"],
  "properties": {
    "schemaVersion": {"type": "string", "const": "phase8.gate-policy-simulation-run.v1"},
    "simulationRunId": {"type": "string", "format": "uuid"},
    "projectId": {"type": "string", "format": "uuid"},
    "policyId": {"type": "string", "format": "uuid"},
    "sourcePolicyVersionId": {"type": ["string", "null"], "format": "uuid"},
    "policyVersionId": {"type": "string", "format": "uuid"},
    "policyVersionHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "evaluatorVersion": {"type": "string", "minLength": 1, "maxLength": 80},
    "runType": {"type": "string", "enum": ["historical", "shadow"]},
    "status": {"type": "string", "enum": ["queued", "running", "completed", "partial", "failed", "cancelled", "timed_out"]},
    "datasetFingerprint": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "totalCases": {"type": "integer", "minimum": 0},
    "completedCases": {"type": "integer", "minimum": 0},
    "unavailableCases": {"type": "integer", "minimum": 0},
    "failedCases": {"type": "integer", "minimum": 0},
    "summary": {"anyOf": [{"$ref": "gate-policy-simulation-summary.schema.json"}, {"type": "null"}]},
    "cases": {"type": "array", "items": {"$ref": "gate-policy-simulation-case-diff.schema.json"}},
    "jobId": {"type": ["string", "null"], "format": "uuid"},
    "traceRef": {"type": ["string", "null"]},
    "errorCode": {"type": ["string", "null"]},
    "retentionUntil": {"type": "string", "format": "date-time"},
    "createdAt": {"type": "string", "format": "date-time"},
    "startedAt": {"type": ["string", "null"], "format": "date-time"},
    "completedAt": {"type": ["string", "null"], "format": "date-time"},
    "authoritative": {"type": "boolean", "const": false},
    "writesGateDecision": {"type": "boolean", "const": false}
  }
}
