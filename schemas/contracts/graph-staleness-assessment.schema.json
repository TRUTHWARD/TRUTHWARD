{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-qa.local/contracts/graph-staleness-assessment.schema.json",
  "title": "Canonical Graph Staleness Assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "assessmentId", "graphId", "graphVersionId", "status",
    "applicabilityRange", "signals", "sourceFingerprint", "ruleVersion",
    "reasonCodes", "impact", "automaticPromotionEligible", "assessmentHash", "assessedAt"
  ],
  "properties": {
    "schemaVersion": {"type": "string", "const": "phase8.graph-staleness-assessment.v1"},
    "assessmentId": {"type": "string", "format": "uuid"},
    "graphId": {"type": "string", "format": "uuid"},
    "graphVersionId": {"type": "string", "format": "uuid"},
    "status": {"type": "string", "enum": ["fresh", "suspect", "stale", "invalid", "unknown"]},
    "applicabilityRange": {"type": "object"},
    "signals": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "sourceFingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "ruleVersion": {"type": "string", "const": "graph-staleness-rules.v1"},
    "reasonCodes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "impact": {"type": "object"},
    "automaticPromotionEligible": {"type": "boolean"},
    "assessmentHash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "assessedAt": {"type": "string", "format": "date-time"}
  }
}
