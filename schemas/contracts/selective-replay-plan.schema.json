{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase8.selective-replay-plan.v1",
  "title": "Selective Replay Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "planId", "projectId", "status", "impactResultRef", "changeSetRefs", "graphRef", "graphVersionRef", "graphAssessmentRef", "coverageSnapshotRef", "policyRefs", "baseExecutionRef", "environmentRef", "algorithmVersion", "inputFingerprint", "selectedTests", "selectionReasons", "riskSummary", "coverageSummary", "budget", "estimatedCost", "fallback", "planHash", "expiresAt", "validity", "createdAt", "createdBy", "guardrailEventRefs", "auditRefs", "replaySnapshot", "deduplicated", "readOnly", "executionCreated", "frontendAuthoritative"],
  "properties": {
    "schemaVersion": {"const": "phase8.selective-replay-plan.v1"},
    "planId": {"type": "string", "format": "uuid"},
    "projectId": {"type": "string", "format": "uuid"},
    "status": {"enum": ["ready", "fallback"]},
    "impactResultRef": {"type": "object"},
    "changeSetRefs": {"type": "array", "minItems": 1},
    "graphRef": {"type": "object"},
    "graphVersionRef": {"type": "object"},
    "graphAssessmentRef": {"type": ["object", "null"]},
    "coverageSnapshotRef": {"type": ["object", "null"]},
    "policyRefs": {"type": "array", "minItems": 1},
    "baseExecutionRef": {"type": "object"},
    "environmentRef": {"type": ["object", "null"]},
    "algorithmVersion": {"const": "p19.selective-replay.v1"},
    "inputFingerprint": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "selectedPaths": {"type": "array"},
    "selectedTests": {"type": "array", "minItems": 1},
    "selectionReasons": {"type": "array", "minItems": 1},
    "riskSummary": {"type": "object"},
    "coverageSummary": {"type": "object"},
    "excludedTests": {"type": "array"},
    "unknownAreas": {"type": "array"},
    "budget": {"type": "object"},
    "estimatedCost": {"type": "object"},
    "fallback": {"type": "object"},
    "planHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "expiresAt": {"type": "string"},
    "validity": {"type": "object"},
    "createdAt": {"type": "string"},
    "createdBy": {"type": ["string", "null"]},
    "guardrailEventRefs": {"type": "array"},
    "auditRefs": {"type": "array"},
    "replaySnapshot": {"type": "object"},
    "deduplicated": {"type": "boolean"},
    "readOnly": {"const": true},
    "executionCreated": {"const": false},
    "frontendAuthoritative": {"const": false}
  }
}
