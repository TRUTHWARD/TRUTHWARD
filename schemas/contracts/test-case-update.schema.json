{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase8.test-case-update.v1",
  "title": "Test Case Update Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "changeType", "testCaseRef", "changes", "rationale", "riskLevel", "evidenceRefs", "metadata"],
  "properties": {
    "schemaVersion": {"type": "string", "const": "phase8.test-case-update.v1"},
    "changeType": {"type": "string", "const": "test_case_update"},
    "testCaseRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "id": {"type": "string", "minLength": 1}
      }
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "before", "after", "reason"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "before": {},
          "after": {},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "rationale": {"type": "string", "minLength": 1},
    "riskLevel": {"type": "string", "enum": ["low", "medium", "high"]},
    "evidenceRefs": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "metadata": {"type": "object"}
  }
}
