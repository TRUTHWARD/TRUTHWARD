{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase8.lesson-candidate.v1",
  "title": "Lesson Candidate Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "candidateId", "projectId", "lessonType", "sourceEvent", "sourceEventHash", "scope", "summary", "observations", "evidenceRefs", "rawRefs", "confidence", "frequency", "impact", "status", "dedupeKey", "clusterKey", "clusterSize", "feedbackSummary", "feedbackConflict", "reviewRefs", "promotionRefs", "traceRefs", "auditRefs", "lockVersion", "expiresAt", "createdAt", "updatedAt", "readOnly"],
  "properties": {
    "schemaVersion": {"type": "string", "const": "phase8.lesson-candidate.v1"},
    "candidateId": {"type": "string"},
    "projectId": {"type": "string"},
    "lessonType": {"type": "string"},
    "sourceEvent": {"type": "object"},
    "sourceEventHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "scope": {"type": "object"},
    "summary": {"type": "string", "minLength": 1},
    "observations": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "evidenceRefs": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "rawRefs": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "frequency": {"type": "integer", "minimum": 1},
    "impact": {"type": "string"},
    "status": {"type": "string"},
    "dedupeKey": {"type": "string", "minLength": 1},
    "clusterKey": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "clusterSize": {"type": "integer", "minimum": 1},
    "feedbackSummary": {"type": "object"},
    "feedbackConflict": {"type": "boolean"},
    "reviewRefs": {"type": "array", "items": {"type": "object"}},
    "promotionRefs": {"type": "array", "items": {"type": "object"}},
    "traceRefs": {"type": "array", "items": {"type": "string"}},
    "auditRefs": {"type": "array", "items": {"type": "object"}},
    "lockVersion": {"type": "integer", "minimum": 1},
    "expiresAt": {"type": ["string", "null"]},
    "createdAt": {"type": "string"},
    "updatedAt": {"type": "string"},
    "readOnly": {"type": "boolean"}
  }
}
