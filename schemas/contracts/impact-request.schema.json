{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase8.impact-request.v1",
  "title": "Impact Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "changeSetIds", "graphId", "graphVersionId", "idempotencyKey"],
  "properties": {
    "schemaVersion": {"const": "phase8.impact-request.v1"},
    "changeSetIds": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "format": "uuid"}},
    "graphId": {"type": "string", "format": "uuid"},
    "graphVersionId": {"type": "string", "format": "uuid"},
    "maxDepth": {"type": "integer", "minimum": 1, "maximum": 12},
    "maxVisitedNodes": {"type": "integer", "minimum": 1, "maximum": 10000},
    "includeAiSuggestions": {"type": "boolean"},
    "idempotencyKey": {"type": "string", "minLength": 8, "maxLength": 255}
  }
}
