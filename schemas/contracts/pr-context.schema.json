{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase8.pr-context.v1",
  "title": "Provider-neutral PR Context",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contextId", "versionId", "version", "provider", "projectId", "repositoryRef", "repositoryNativeId", "pullRequestNumber", "revision", "authorRef", "draft", "state", "action", "changeSetRef", "receivedAt", "providerEventAt", "bindingSnapshot", "webhookReceiptRef", "skillInvocationRef", "contextHash", "readOnly", "executionCreated"],
  "properties": {
    "schemaVersion": {"const": "phase8.pr-context.v1"},
    "contextId": {"type": "string", "format": "uuid"},
    "versionId": {"type": "string", "format": "uuid"},
    "version": {"type": "integer", "minimum": 1},
    "provider": {"enum": ["github", "gitlab", "mock-scm"]},
    "projectId": {"type": "string", "format": "uuid"},
    "repositoryRef": {"type": "string", "minLength": 1},
    "repositoryNativeId": {"type": "string", "minLength": 1},
    "pullRequestNumber": {"type": "integer", "minimum": 1},
    "revision": {"type": "object"},
    "authorRef": {"type": "string", "minLength": 1},
    "draft": {"type": "boolean"},
    "state": {"enum": ["open", "closed", "merged", "unknown"]},
    "action": {"type": "string", "minLength": 1},
    "fork": {"type": "boolean"},
    "labels": {"type": "array"},
    "changedFiles": {"type": "array"},
    "changeSetRef": {"type": ["object", "null"]},
    "explicitRequirementRefs": {"type": "array"},
    "receivedAt": {"type": "string"},
    "providerEventAt": {"type": "string"},
    "bindingSnapshot": {"type": "object"},
    "webhookReceiptRef": {"type": "object"},
    "skillInvocationRef": {"type": ["object", "null"]},
    "evidenceRefs": {"type": "array"},
    "contextHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "readOnly": {"const": true},
    "gateDecision": {"type": "null"},
    "executionCreated": {"const": false}
  }
}
