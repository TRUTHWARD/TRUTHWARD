{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase8.impact-result.v1",
  "title": "Impact Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "impactResultId", "projectId", "status", "inputFingerprint", "deduplicated", "riskLevel", "confidence", "changeSetRefs", "graphRef", "graphVersionRef", "graphStaleness", "graphAssessmentRef", "mappingSnapshotHash", "mappingVersionRefs", "algorithmVersion", "modelInvocationRefs", "guardrailEventRefs", "impactedCapabilities", "impactedPaths", "impactedTests", "impactedRiskDomains", "unknownAreas", "recommendedFallbacks", "aiSuggestions", "reviewRequired", "approvalRef", "truncated", "visitedNodeCount", "traceId", "auditRefs", "replaySnapshot", "createdAt"],
  "properties": {
    "schemaVersion": {"const": "phase8.impact-result.v1"},
    "impactResultId": {"type": "string"},
    "projectId": {"type": "string"},
    "status": {"enum": ["complete", "partial", "unknown"]},
    "inputFingerprint": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "deduplicated": {"type": "boolean"},
    "riskLevel": {"$ref": "#/$defs/risk"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "changeSetRefs": {"type": "array", "items": {"$ref": "#/$defs/ref"}},
    "graphRef": {"$ref": "#/$defs/ref"},
    "graphVersionRef": {"$ref": "#/$defs/ref"},
    "graphStaleness": {"enum": ["fresh", "suspect", "stale", "invalid", "unknown"]},
    "graphAssessmentRef": {"oneOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]},
    "mappingSnapshotHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "mappingVersionRefs": {"type": "array", "items": {"$ref": "#/$defs/ref"}},
    "algorithmVersion": {"const": "p18.impact-propagation.v1"},
    "modelInvocationRefs": {"type": "array", "items": {"$ref": "#/$defs/ref"}},
    "guardrailEventRefs": {"type": "array", "items": {"$ref": "#/$defs/ref"}},
    "impactedCapabilities": {"type": "array", "items": {"$ref": "#/$defs/entity"}},
    "impactedPaths": {"type": "array", "items": {"$ref": "#/$defs/path"}},
    "impactedTests": {"type": "array", "items": {"$ref": "#/$defs/test"}},
    "impactedRiskDomains": {"type": "array", "items": {"$ref": "#/$defs/entity"}},
    "unknownAreas": {"type": "array", "items": {"$ref": "#/$defs/uncertainty"}},
    "recommendedFallbacks": {"type": "array", "items": {"$ref": "#/$defs/fallback"}},
    "aiSuggestions": {"type": "array", "items": {"$ref": "#/$defs/suggestion"}},
    "reviewRequired": {"type": "boolean"},
    "approvalRef": {"oneOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]},
    "truncated": {"type": "boolean"},
    "visitedNodeCount": {"type": "integer", "minimum": 0},
    "traceId": {"type": "string"},
    "auditRefs": {"type": "array", "items": {"$ref": "#/$defs/ref"}},
    "replaySnapshot": {"type": "object"},
    "createdAt": {"type": "string"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "risk": {"enum": ["low", "medium", "high"]},
    "source": {"enum": ["manual", "explicit_configuration", "verified_traceability", "static_symbol_coverage", "historical_evidence", "ai_suggestion", "graph_propagation"]},
    "ref": {"type": "object", "additionalProperties": false, "required": ["type", "ref", "contentHash"], "properties": {"type": {"type": "string"}, "ref": {"type": "string"}, "contentHash": {"type": ["string", "null"]}}},
    "step": {"type": "object", "additionalProperties": false, "required": ["order", "entityType", "entityRef", "viaRelation", "direction", "confidence", "evidenceRefs"], "properties": {"order": {"type": "integer", "minimum": 0}, "entityType": {"type": "string"}, "entityRef": {"type": "string"}, "viaRelation": {"type": ["string", "null"]}, "direction": {"enum": ["seed", "forward", "reverse", "mapping"]}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "evidenceRefs": {"type": "array", "items": {"$ref": "#/$defs/ref"}}}},
    "entity": {"type": "object", "additionalProperties": false, "required": ["entityType", "entityRef", "label", "riskLevel", "confidence", "mappingSource", "evidenceRefs", "propagationPath"], "properties": {"entityType": {"enum": ["capability", "risk_domain"]}, "entityRef": {"type": "string"}, "label": {"type": ["string", "null"]}, "riskLevel": {"$ref": "#/$defs/risk"}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "mappingSource": {"$ref": "#/$defs/source"}, "evidenceRefs": {"type": "array", "items": {"$ref": "#/$defs/ref"}}, "propagationPath": {"type": "array", "items": {"$ref": "#/$defs/step"}}}},
    "path": {"type": "object", "additionalProperties": false, "required": ["pathId", "pathRef", "name", "riskLevel", "confidence", "evidenceRefs", "propagationPath"], "properties": {"pathId": {"type": "string"}, "pathRef": {"type": "string"}, "name": {"type": "string"}, "riskLevel": {"$ref": "#/$defs/risk"}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "evidenceRefs": {"type": "array", "items": {"$ref": "#/$defs/ref"}}, "propagationPath": {"type": "array", "items": {"$ref": "#/$defs/step"}}}},
    "test": {"type": "object", "additionalProperties": false, "required": ["testRef", "testKind", "riskLevel", "confidence", "evidenceRefs", "propagationPath"], "properties": {"testRef": {"type": "string"}, "testKind": {"type": ["string", "null"]}, "riskLevel": {"$ref": "#/$defs/risk"}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "evidenceRefs": {"type": "array", "items": {"$ref": "#/$defs/ref"}}, "propagationPath": {"type": "array", "items": {"$ref": "#/$defs/step"}}}},
    "uncertainty": {"type": "object", "additionalProperties": false, "required": ["code", "areaType", "areaRef", "messageKey", "riskLevel", "evidenceRefs", "reviewRequired"], "properties": {"code": {"type": "string"}, "areaType": {"enum": ["change", "mapping", "graph", "path", "test", "model", "scope"]}, "areaRef": {"type": ["string", "null"]}, "messageKey": {"type": "string"}, "riskLevel": {"$ref": "#/$defs/risk"}, "evidenceRefs": {"type": "array", "items": {"$ref": "#/$defs/ref"}}, "reviewRequired": {"type": "boolean"}}},
    "fallback": {"type": "object", "additionalProperties": false, "required": ["code", "reason", "recommendedAction"], "properties": {"code": {"enum": ["FULL_REGRESSION_RECOMMENDED", "SECURITY_REVIEW_RECOMMENDED", "MANUAL_MAPPING_REVIEW_REQUIRED", "GRAPH_REFRESH_REQUIRED", "MODEL_SUGGESTION_UNAVAILABLE"]}, "reason": {"type": "string"}, "recommendedAction": {"enum": ["full_regression", "security_review", "mapping_review", "graph_refresh", "manual_analysis"]}}},
    "suggestion": {"type": "object", "additionalProperties": false, "required": ["sourceEntityRef", "suggestedCapabilityRef", "confidence", "rationale", "evidenceRefs", "canonical", "reviewRequired"], "properties": {"sourceEntityRef": {"type": "string"}, "suggestedCapabilityRef": {"type": "string"}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "rationale": {"type": "string"}, "evidenceRefs": {"type": "array", "items": {"$ref": "#/$defs/ref"}}, "canonical": {"const": false}, "reviewRequired": {"const": true}}}
  }
}
