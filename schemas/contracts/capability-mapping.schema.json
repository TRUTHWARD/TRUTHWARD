{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase8.capability-mapping.v1",
  "title": "Capability Mapping",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mappingId", "mappingKey", "version", "projectId", "sourceEntityType", "sourceEntityRef", "capabilityRef", "mappingSource", "sourcePriority", "confidence", "status", "repositoryRef", "graphVersionId", "evidenceRefs", "contentHash", "traceId", "createdAt", "createdBy"],
  "properties": {
    "schemaVersion": {"const": "phase8.capability-mapping.v1"},
    "mappingId": {"type": "string"},
    "mappingKey": {"type": "string"},
    "version": {"type": "integer", "minimum": 1},
    "projectId": {"type": "string"},
    "sourceEntityType": {"enum": ["requirement", "code_path", "code_symbol", "test"]},
    "sourceEntityRef": {"type": "string"},
    "capabilityRef": {"type": "string"},
    "mappingSource": {"enum": ["manual", "explicit_configuration", "verified_traceability", "static_symbol_coverage", "historical_evidence"]},
    "sourcePriority": {"type": "integer", "minimum": 0},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "status": {"enum": ["active", "superseded", "disabled"]},
    "repositoryRef": {"type": ["string", "null"]},
    "graphVersionId": {"type": ["string", "null"]},
    "evidenceRefs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ref"}},
    "contentHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "traceId": {"type": "string"},
    "createdAt": {"type": "string"},
    "createdBy": {"type": ["string", "null"]}
  },
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "ref", "contentHash"],
      "properties": {"type": {"type": "string"}, "ref": {"type": "string"}, "contentHash": {"type": ["string", "null"]}}
    }
  }
}
