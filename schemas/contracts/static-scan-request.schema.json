{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "phase8.static-scan-request.v1",
  "title": "Static Scan Request", "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "prContextVersionId", "sourceArtifactRef", "headSha", "sandboxProfile", "idempotencyKey"],
  "properties": {
    "schemaVersion": {"const": "phase8.static-scan-request.v1"}, "prContextVersionId": {"type": "string"},
    "sourceArtifactRef": {"type": "object"}, "headSha": {"type": "string", "pattern": "^[a-f0-9]{7,64}$"},
    "tools": {"type": "array", "minItems": 1}, "sandboxProfile": {"type": "object"},
    "idempotencyKey": {"type": "string", "minLength": 8, "maxLength": 255}
  }
}
