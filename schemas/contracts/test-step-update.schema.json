{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase8.test-step-update.v1",
  "title": "Test Step Update Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "changeType", "testStepRef", "beforeStep", "afterStep", "rationale", "riskLevel", "evidenceRefs", "metadata"],
  "properties": {
    "schemaVersion": {"type": "string", "const": "phase8.test-step-update.v1"},
    "changeType": {"type": "string", "const": "test_step_update"},
    "testStepRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "id": {"type": "string", "minLength": 1}
      }
    },
    "beforeStep": {"type": "object"},
    "afterStep": {"type": "object"},
    "rationale": {"type": "string", "minLength": 1},
    "riskLevel": {"type": "string", "enum": ["low", "medium", "high"]},
    "evidenceRefs": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "metadata": {"type": "object"}
  }
}
