{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase8.gate-policy-import-request.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "content"],
  "properties": {
    "format": {"type": "string", "enum": ["json", "yaml"]},
