{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase8.finding.v1",
  "title": "Canonical Finding Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "source",
    "category",
    "severity",
    "title",
    "summary",
    "evidence",
    "location",
    "confidence",
    "dedupeKey",
    "rawRef"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "location": {
      "type": "object"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "dedupeKey": {
      "type": "string",
      "minLength": 1
    },
    "rawRef": {
      "type": "string",
      "minLength": 1
    }
  }
}
