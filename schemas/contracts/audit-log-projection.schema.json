{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-qa.local/contracts/audit-log-projection.schema.json",
  "title": "Audit Log Projection",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "phase8.audit-log-projection.v1"
    },
    "generatedAt": {
      "type": "string"
    },
    "scope": {
      "type": "object"
    },
    "filters": {
      "type": "object"
    },
    "supportedFilters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "object"
    },
    "sourceCounts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "levelCounts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "resourceTypeCounts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "retentionProjection": {
      "type": "object"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "page": {
      "type": "integer",
      "minimum": 1
    },
    "pageSize": {
      "type": "integer",
      "minimum": 1
    },
    "evidenceOnly": {
      "type": "boolean"
    },
    "writesDecision": {
      "type": "boolean"
    },
    "capability": {
      "type": "object"
    }
  },
  "required": [
    "schemaVersion",
    "generatedAt",
    "scope",
    "filters",
    "supportedFilters",
    "summary",
    "sourceCounts",
    "levelCounts",
    "resourceTypeCounts",
    "retentionProjection",
    "items",
    "total",
    "page",
    "pageSize",
    "evidenceOnly",
    "writesDecision",
    "capability"
  ]
}
