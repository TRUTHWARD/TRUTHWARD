{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase8.improvement-proposal.v1",
  "title": "Improvement Proposal Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "proposalId", "projectId", "sourceLessonRefs", "targetType", "target", "changeSpec", "changeHash", "rationale", "evidenceRefs", "requestedRisk", "evaluatedRisk", "confidence", "validationPlan", "validationRefs", "status", "approvalRefs", "routeRefs", "effectivenessRefs", "rollbackRefs", "traceRefs", "auditRefs", "effectivenessWindow", "lockVersion", "createdAt", "updatedAt", "readOnly", "productionAppliedByProposalService", "automaticSelfEvolution"],
  "properties": {
    "schemaVersion": {"type": "string", "const": "phase8.improvement-proposal.v1"},
    "proposalId": {"type": "string"},
    "projectId": {"type": "string"},
    "sourceLessonRefs": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "targetType": {"type": "string", "enum": ["skill", "gate_policy", "graph", "graph_learning_policy", "test_case", "test_step", "tool_config", "connector_config"]},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetId", "targetKey", "baseVersion", "baseHash"],
      "properties": {
        "targetId": {"type": "string", "minLength": 1},
        "targetKey": {"type": "string", "minLength": 1},
        "baseVersion": {"type": "string", "minLength": 1},
        "baseHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "changeSpec": {
      "type": "object",
      "required": ["schemaVersion", "summary", "operations", "authorityRequest", "rollbackSpec"],
      "properties": {
        "schemaVersion": {"type": "string", "const": "phase8.improvement-change-spec.v1"},
        "summary": {"type": "string", "minLength": 1},
        "operations": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "authorityRequest": {"type": "object"},
        "rollbackSpec": {"type": "object"}
      }
    },
    "changeHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "rationale": {"type": "string"},
    "evidenceRefs": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "requestedRisk": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
    "evaluatedRisk": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
    "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "validationPlan": {"type": "object"},
    "validationRefs": {"type": "array", "items": {"type": "object"}},
    "status": {"type": "string", "enum": ["draft", "validation_failed", "validated", "review_pending", "review_approved", "review_rejected", "routed", "effectiveness_pending", "effective", "ineffective", "inconclusive", "rollback_pending", "rollback_routed", "partial", "failed", "archived"]},
    "approvalRefs": {"type": "array", "items": {"type": "object"}},
    "routeRefs": {"type": "array", "items": {"type": "object"}},
    "effectivenessRefs": {"type": "array", "items": {"type": "object"}},
    "rollbackRefs": {"type": "array", "items": {"type": "object"}},
    "traceRefs": {"type": "array", "items": {"type": "string"}},
    "auditRefs": {"type": "array", "items": {"type": "object"}},
    "effectivenessWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startsAt", "endsAt", "minimumSamples"],
      "properties": {
        "startsAt": {"type": "string"},
        "endsAt": {"type": "string"},
        "minimumSamples": {"type": "integer", "minimum": 1}
      }
    },
    "lockVersion": {"type": "integer", "minimum": 1},
    "createdAt": {"type": "string"},
    "updatedAt": {"type": "string"},
    "readOnly": {"type": "boolean"},
    "productionAppliedByProposalService": {"type": "boolean", "const": false},
    "automaticSelfEvolution": {"type": "boolean", "const": false}
  }
}
